import torch
import torch.nn as nn
import matplotlib.pyplot as plt
from torchdiffeq import odeint

torch.manual_seed(0)

# --------------------------------
# 1. 학습 데이터 생성
# --------------------------------
t = torch.linspace(0.0, 2.0, 50)

# 정확해 y = exp(-2t)
y_true = torch.exp(-2.0 * t).reshape(-1, 1)

# 초기값
y0 = torch.tensor([1.0])

# --------------------------------
# 2. Neural ODE 함수
# --------------------------------
class ODEFunc(nn.Module):

    def __init__(self):
        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(1, 16),
            nn.Tanh(),
            nn.Linear(16, 16),
            nn.Tanh(),
            nn.Linear(16, 1)
        )

    def forward(self, t, y):
        return self.net(y)


func = ODEFunc()

optimizer = torch.optim.Adam(
    func.parameters(),
    lr=0.01
)

# --------------------------------
# 3. 학습
# --------------------------------
for epoch in range(1000):

    optimizer.zero_grad()

    y_pred = odeint(
        func,
        y0,
        t,
        method='dopri5'
    )

    loss = torch.mean(
        (y_pred - y_true)**2
    )

    loss.backward()
    optimizer.step()

    if epoch % 100 == 0:
        print(epoch, loss.item())

# --------------------------------
# 4. 결과
# --------------------------------
with torch.no_grad():

    y_pred = odeint(
        func,
        y0,
        t
    )

plt.plot(
    t.numpy(),
    y_true.numpy(),
    label='Exact solution'
)

plt.plot(
    t.numpy(),
    y_pred.numpy(),
    '--',
    label='Neural ODE'
)

plt.xlabel('t')
plt.ylabel('y')
plt.legend()
plt.grid()

plt.show()
