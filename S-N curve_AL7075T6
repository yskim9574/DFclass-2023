# ==========================================================
# 2. 그래프 공통 설정
# ==========================================================
plt.rcParams.update({
    "font.size": 15,
    "axes.labelsize": 20,
    "axes.titlesize": 19,
    "xtick.labelsize": 16,
    "ytick.labelsize": 16,
    "legend.fontsize": 13,
    "axes.linewidth": 1.2
})

r_values = sorted(df["R"].unique(), reverse=True)

colors = plt.get_cmap("tab10").colors
markers = ["o", "s", "^", "D", "v", "P", "X", "<", ">"]

# 동일한 R은 두 그래프에서 같은 색상과 기호 사용
styles = {
    r: (colors[i], markers[i])
    for i, r in enumerate(r_values)
}

# ==========================================================
# 3. S-N 선도 작성 함수
# ==========================================================
def plot_sn(column, ylabel, title, filename, ylim, yticks):
    fig, ax = plt.subplots(figsize=(10, 7), dpi=150)

    for r in r_values:
        group = df[df["R"] == r]
        color, marker = styles[r]

        ax.scatter(
            group["N_f"],
            group[column],
            s=75,
            marker=marker,
            facecolors="none",
            edgecolors=color,
            linewidths=1.7,
            label=fr"$R={r:.2f}$",
            zorder=3
        )

    # 양대수 좌표
    ax.set_xscale("log")
    ax.set_yscale("log")

    ax.set_xlim(5e3, 2e7)
    ax.set_ylim(*ylim)

    ax.set_xticks([1e4, 1e5, 1e6, 1e7])
    ax.set_yticks(yticks)

    # y축 응력을 100, 200 등 일반 숫자로 표시
    ax.yaxis.set_major_formatter(ScalarFormatter())
    ax.yaxis.set_minor_formatter(NullFormatter())

    ax.xaxis.set_minor_locator(
        LogLocator(base=10, subs=np.arange(2, 10))
    )

    ax.set_xlabel(r"Cycles to failure, $N_f$ (cycles)")
    ax.set_ylabel(ylabel)
    ax.set_title(title, pad=15)

    ax.grid(which="major", linestyle="-", alpha=0.30)
    ax.grid(which="minor", linestyle=":", alpha=0.15)

    ax.tick_params(
        which="major", direction="in",
        length=7, width=1.2
    )
    ax.tick_params(
        which="minor", direction="in",
        length=4
    )

    # 範例放在圖外，避免遮擋資料
    ax.legend(
        title="Stress ratio",
        title_fontsize=14,
        loc="upper left",
        bbox_to_anchor=(1.02, 1.0),
        borderaxespad=0
    )

    fig.tight_layout()

    # 고해상도 그림 및 벡터 PDF 저장
    fig.savefig(f"{filename}.png", dpi=300, bbox_inches="tight")
    fig.savefig(f"{filename}.pdf", bbox_inches="tight")

    plt.show()

