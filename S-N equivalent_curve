SIGMA_U = 568.8   # tensile strength: 82,500 psi (NACA TN 2324, Table 1)
GAMMA = 0.39      # Walker exponent

df = pd.DataFrame(DATA, columns=['R', 'sigma_max', 'sigma_min', 'sigma_a', 'N_f'])
df['sigma_m'] = (df.sigma_max + df.sigma_min) / 2
df.to_csv(OUT / 'input_data.csv', index=False)
assert (df.sigma_m < SIGMA_U).all()
df['Goodman'] = df.sigma_a / (1 - df.sigma_m / SIGMA_U)
df['Walker'] = df.sigma_max**(1 - GAMMA) * df.sigma_a**GAMMA
df.to_csv(OUT / 'equivalent_stress_data.csv', index=False)

colors = ['#0072B2', '#888888', '#D55E00', '#AA4499', '#009E73', '#CC79A7', '#E69F00', '#44AACC', '#332288']
markers = ['o', 's', '^', 'D', 'v', 'P', 'X', '<', '>']
rvals = sorted(df.R.unique(), reverse=True)
plt.rcParams.update({'font.size': 14, 'axes.labelsize': 19, 'xtick.labelsize': 15, 'ytick.labelsize': 15,
                     'axes.linewidth': 1.2, 'pdf.fonttype': 42})

for method in ['Goodman', 'Walker']:
    fig, ax = plt.subplots(figsize=(10, 7.2))
    fig.subplots_adjust(left=.14, right=.78, bottom=.14, top=.87)
    for r, c, m in zip(rvals, colors, markers):
        g = df[df.R == r]
        ax.scatter(g.N_f, g[method], s=65, marker=m, facecolors='none', edgecolors=c,
                   linewidths=1.6, label=f'R = {r:.2f}', zorder=3)
    ax.set_xscale('log'); ax.set_yscale('log')
    ax.set_xlim(5e3, 2e7); ax.set_ylim(120, 650)
    ax.set_xticks([1e4, 1e5, 1e6, 1e7]); ax.set_yticks([120, 150, 200, 300, 400, 500, 600])
    ax.yaxis.set_major_formatter(ScalarFormatter()); ax.yaxis.set_minor_formatter(NullFormatter())
    ax.set_xlabel(r'Cycles to failure, $N_f$ (cycles)')
    ax.set_ylabel(r'Equivalent stress amplitude, $\sigma_{a,eq}$ (MPa)')
    title = '7075-T6 aluminum sheet — ' + method + ' correction'
    note = (rf'Tensile strength: $\sigma_u={SIGMA_U:g}$ MPa' if method == 'Goodman'
            else rf'$\gamma={GAMMA}$; $\sigma_{{a,eq}}=\sigma_{{\max}}^{{1-\gamma}}\sigma_a^\gamma$')
    ax.set_title(title + '\n' + note, fontsize=16, pad=12)
    ax.grid(which='major', alpha=.25); ax.grid(which='minor', alpha=.12, ls=':')
    ax.tick_params(which='both', direction='in', top=True, right=True)
    ax.legend(loc='upper left', bbox_to_anchor=(1.02, 1), fontsize=12, frameon=False)
    for ext in ['png', 'pdf', 'svg']:
        fig.savefig(OUT / f'7075T6_{method}_equivalent_SN.{ext}', dpi=300)
    plt.show()          # show the figure in Colab

print(df.groupby('R')[['Goodman', 'Walker']].agg(['min', 'max']).round(2))

