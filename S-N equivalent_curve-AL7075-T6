def basquin_fit(N, s):
    """Least-squares fit of log10(s) = log10(sf) + b*log10(2N)  ->  s = sf*(2N)^b."""
    x, y = np.log10(2 * N), np.log10(s)
    n = len(x)
    b, a = np.polyfit(x, y, 1)
    res = y - (a + b * x)
    sd = np.sqrt(np.sum(res**2) / (n - 2))              # standard error of estimate (log10 stress)
    r2 = 1 - np.sum(res**2) / np.sum((y - y.mean())**2)
    t = stats.t.ppf(0.5 + CONF / 2, n - 2)
    xm, sxx = x.mean(), np.sum((x - x.mean())**2)
    def band(Nq):                                          # prediction interval for a new specimen
        xq = np.log10(2 * np.asarray(Nq))
        half = t * sd * np.sqrt(1 + 1 / n + (xq - xm)**2 / sxx)
        yq = a + b * xq
        return 10**yq, 10**(yq - half), 10**(yq + half)
    return dict(sf=10**a, b=b, sd=sd, r2=r2, n=n, t=t, band=band)


