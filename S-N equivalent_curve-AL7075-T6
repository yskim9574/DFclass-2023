summary = []
for method in ['Goodman', 'Walker']:
    use = df.N_f <= FIT_NMAX
    fit = basquin_fit(df.N_f[use].values, df[method][use].values)
    summary.append((method, fit['sf'], fit['b'], fit['r2'], fit['sd'], 10**(fit['t'] * fit['sd']), fit['n']))

    fig, ax = plt.subplots(figsize=(10, 7.2))
    fig.subplots_adjust(left=.14, right=.74, bottom=.14, top=.87)
    for r, c, m in zip(rvals, colors, markers):
        g = df[df.R == r]
        ax.scatter(g.N_f, g[method], s=65, marker=m, facecolors='none', edgecolors=c,
                   linewidths=1.6, label=f'R = {r:.2f}', zorder=3)
    Nq = np.logspace(np.log10(5e3), np.log10(FIT_NMAX), 200)
    mid, lo, hi = fit['band'](Nq)
    ax.fill_between(Nq, lo, hi, color='0.6', alpha=0.18, lw=0, zorder=1)
    ax.plot(Nq, mid, 'k-', lw=2.2, zorder=2, label='Basquin fit')
    ax.plot(Nq, lo, 'k--', lw=1.3, zorder=2, label=f'{CONF*100:.0f}% prediction band')
    ax.plot(Nq, hi, 'k--', lw=1.3, zorder=2)
    ax.axvline(FIT_NMAX, color='0.5', ls=':', lw=1.2)
    ax.text(FIT_NMAX * 1.08, 128, 'fit limit', color='0.4', fontsize=11)
